diff --git a/arch/arm64/configs/enchilada_defconfig b/arch/arm64/configs/enchilada_defconfig
index 2bf23f91c..e996a528e 100644
--- a/arch/arm64/configs/enchilada_defconfig
+++ b/arch/arm64/configs/enchilada_defconfig
@@ -693,3 +693,104 @@ CONFIG_DEFAULT_BBR=y
 # or lz4 (faster) instead of the default lzo.
 CONFIG_CRYPTO_LZ4=y
 CONFIG_CRYPTO_ZSTD=y
+
+# ============================================================
+# Docker / LXC / Droidspaces container support
+# Required for running full Linux containers with systemd as PID 1
+# and nested Docker inside Droidspaces containers.
+# Reference: https://www.droidspaces.org/docs/kernel-configuration.html
+# ============================================================
+
+# --- namespaces ---
+CONFIG_UTS_NS=y
+CONFIG_IPC_NS=y
+CONFIG_PID_NS=y
+CONFIG_NET_NS=y
+CONFIG_USER_NS=y
+CONFIG_NAMESPACES=y
+
+# --- IPC (systemd needs SYSV IPC + POSIX message queues) ---
+CONFIG_SYSVIPC=y
+CONFIG_POSIX_MQUEUE=y
+
+# --- cgroups (cgroup v1 on 4.9; systemd + Docker need these controllers) ---
+CONFIG_CGROUPS=y
+CONFIG_CGROUP_PIDS=y
+CONFIG_CGROUP_SCHED=y
+CONFIG_FAIR_GROUP_SCHED=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_CGROUP_CPUACCT=y
+CONFIG_BLK_CGROUP=y
+CONFIG_CFQ_GROUP_IOSCHED=y
+CONFIG_MEMCG=y
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CGROUP_NET_PRIO=y
+
+# --- filesystems ---
+CONFIG_DEVTMPFS=y
+CONFIG_OVERLAY_FS=y
+CONFIG_TMPFS_POSIX_ACL=y
+CONFIG_TMPFS_XATTR=y
+
+# --- container networking (NAT / bridge / veth) ---
+CONFIG_VETH=y
+CONFIG_BRIDGE=y
+CONFIG_NETFILTER=y
+CONFIG_BRIDGE_NETFILTER=y
+CONFIG_NETFILTER_ADVANCED=y
+CONFIG_NF_CONNTRACK=y
+CONFIG_IP_NF_IPTABLES=y
+CONFIG_IP_NF_FILTER=y
+CONFIG_NF_NAT=y
+CONFIG_NF_TABLES=y
+CONFIG_IP_NF_TARGET_MASQUERADE=y
+CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
+CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
+CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
+CONFIG_NF_CONNTRACK_NETLINK=y
+CONFIG_NF_NAT_REDIRECT=y
+CONFIG_IP_ADVANCED_ROUTER=y
+CONFIG_IP_MULTIPLE_TABLES=y
+CONFIG_NF_CONNTRACK_IPV4=y
+CONFIG_NF_NAT_IPV4=y
+CONFIG_IP_NF_NAT=y
+
+# --- ebtables (Docker/libnetwork bridge isolation rules) ---
+CONFIG_BRIDGE_EBT_802_3=y
+CONFIG_BRIDGE_EBT_AMONG=y
+CONFIG_BRIDGE_EBT_ARP=y
+CONFIG_BRIDGE_EBT_ARPREPLY=y
+CONFIG_BRIDGE_EBT_DNAT=y
+CONFIG_BRIDGE_EBT_IP=y
+CONFIG_BRIDGE_EBT_IP6=y
+CONFIG_BRIDGE_EBT_LIMIT=y
+CONFIG_BRIDGE_EBT_LOG=y
+CONFIG_BRIDGE_EBT_MARK=y
+CONFIG_BRIDGE_EBT_MARK_T=y
+CONFIG_BRIDGE_EBT_NFLOG=y
+CONFIG_BRIDGE_EBT_PKTTYPE=y
+CONFIG_BRIDGE_EBT_REDIRECT=y
+CONFIG_BRIDGE_EBT_SNAT=y
+CONFIG_BRIDGE_EBT_STP=y
+CONFIG_BRIDGE_EBT_T_FILTER=y
+CONFIG_BRIDGE_EBT_T_NAT=y
+CONFIG_BRIDGE_EBT_VLAN=y
+
+CONFIG_CGROUP_BPF=y
+
+# --- BPF JIT (kernel BPF programs run natively; needed by container
+#     runtimes on cgroup v2).  NOTE: BPF_JIT_ALWAYS_ON is deliberately NOT
+#     enabled here - it was responsible for boot loops in earlier builds.
+# ---
+CONFIG_BPF_JIT=y
+CONFIG_HAVE_EBPF_JIT=y
+
+# --- seccomp (BPF filter for container security) ---
+CONFIG_SECCOMP=y
+CONFIG_SECCOMP_FILTER=y
+
+# --- firmware loader (container firmware passthrough) ---
+CONFIG_FW_LOADER=y
+CONFIG_FW_LOADER_USER_HELPER=y
+
+# --- disable Android paranoid network so containers get internet ---
+# (aid_inet gid is handled by Droidspaces rootfs instead)
+# CONFIG_ANDROID_PARANOID_NETWORK is not set
