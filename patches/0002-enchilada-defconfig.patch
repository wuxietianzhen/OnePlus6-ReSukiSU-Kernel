diff --git a/arch/arm64/configs/enchilada_defconfig b/arch/arm64/configs/enchilada_defconfig
index 826ca34db..2bf23f91c 100644
--- a/arch/arm64/configs/enchilada_defconfig
+++ b/arch/arm64/configs/enchilada_defconfig
@@ -35,7 +35,8 @@ CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
 # CONFIG_RD_XZ is not set
 # CONFIG_RD_LZO is not set
 # CONFIG_RD_LZ4 is not set
-CONFIG_CC_OPTIMIZE_FOR_SIZE=y
+# v3: optimize for performance (-O2) instead of size (-Os)
+CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
 CONFIG_KALLSYMS_ALL=y
 CONFIG_BPF_SYSCALL=y
 CONFIG_EMBEDDED=y
@@ -634,7 +635,7 @@ CONFIG_PRINTK_TIME=y
 CONFIG_DEBUG_INFO=y
 CONFIG_MAGIC_SYSRQ=y
 CONFIG_PANIC_TIMEOUT=5
-CONFIG_SCHEDSTATS=y
+# CONFIG_SCHEDSTATS is not set
 # CONFIG_DEBUG_PREEMPT is not set
 CONFIG_IPC_LOGGING=y
 CONFIG_CPU_FREQ_SWITCH_PROFILER=y
@@ -664,3 +665,104 @@ CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
 CONFIG_CRYPTO_AES_ARM64_NEON_BLK=y
 CONFIG_CRYPTO_CRC32_ARM64=y
 CONFIG_QMI_ENCDEC=y
+
+# ReSukiSU (KernelSU) root support - manual hook (non-GKI 4.9)
+CONFIG_KSU=y
+CONFIG_KSU_MANUAL_HOOK=y
+# v2: only trust the ReSukiSU manager (drop MKSU/RKSU/KOWSU/SukiSU-Ultra)
+# CONFIG_KSU_MULTI_MANAGER_SUPPORT is not set
+
+# v2: balanced power/scheduling - boot with schedutil (EAS) instead of
+# the performance governor; userspace still sets the runtime governor.
+CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
+
+# v3: fixed kernel version string -> 4.9.337-byVoLResukisu
+# (LOCALVERSION_AUTO off + empty .scmversion suppress the git -g..-dirty suffix)
+CONFIG_LOCALVERSION="-byVoLResukisu"
+# CONFIG_LOCALVERSION_AUTO is not set
+
+# v3: TCP BBR congestion control + fair-queue qdisc (better throughput/latency
+# on wifi and mobile data); make BBR the kernel default congestion algorithm.
+# TCP_CONG_ADVANCED must be on to expose the individual algorithms.
+CONFIG_TCP_CONG_ADVANCED=y
+CONFIG_TCP_CONG_BBR=y
+CONFIG_NET_SCH_FQ=y
+CONFIG_DEFAULT_BBR=y
+
+# v3: extra zram compression backends so userspace can pick zstd (better ratio)
+# or lz4 (faster) instead of the default lzo.
+CONFIG_CRYPTO_LZ4=y
+CONFIG_CRYPTO_ZSTD=y
+
+# ============================================================
+# Docker / LXC / Droidspaces container support
+# Required for running full Linux containers with systemd as PID 1
+# and nested Docker inside Droidspaces containers.
+# Reference: https://www.droidspaces.org/docs/kernel-configuration.html
+# ============================================================
+
+# --- namespaces ---
+CONFIG_UTS_NS=y
+CONFIG_IPC_NS=y
+CONFIG_PID_NS=y
+CONFIG_NET_NS=y
+CONFIG_USER_NS=y
+CONFIG_NAMESPACES=y
+
+# --- IPC (systemd needs SYSV IPC + POSIX message queues) ---
+CONFIG_SYSVIPC=y
+CONFIG_POSIX_MQUEUE=y
+
+# --- cgroups (cgroup v1 on 4.9; systemd + Docker need these controllers) ---
+CONFIG_CGROUPS=y
+CONFIG_CGROUP_PIDS=y
+CONFIG_CGROUP_SCHED=y
+CONFIG_FAIR_GROUP_SCHED=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_CGROUP_CPUACCT=y
+CONFIG_BLK_CGROUP=y
+CONFIG_CFQ_GROUP_IOSCHED=y
+CONFIG_MEMCG=y
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CGROUP_NET_PRIO=y
+
+# --- filesystems ---
+CONFIG_DEVTMPFS=y
+CONFIG_OVERLAY_FS=y
+CONFIG_TMPFS_POSIX_ACL=y
+CONFIG_TMPFS_XATTR=y
+
+# --- container networking (NAT / bridge / veth) ---
+CONFIG_VETH=y
+CONFIG_BRIDGE=y
+CONFIG_NETFILTER=y
+CONFIG_BRIDGE_NETFILTER=y
+CONFIG_NETFILTER_ADVANCED=y
+CONFIG_NF_CONNTRACK=y
+CONFIG_IP_NF_IPTABLES=y
+CONFIG_IP_NF_FILTER=y
+CONFIG_NF_NAT=y
+CONFIG_NF_TABLES=y
+CONFIG_IP_NF_TARGET_MASQUERADE=y
+CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
+CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
+CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
+CONFIG_NF_CONNTRACK_NETLINK=y
+CONFIG_NF_NAT_REDIRECT=y
+CONFIG_IP_ADVANCED_ROUTER=y
+CONFIG_IP_MULTIPLE_TABLES=y
+CONFIG_NF_CONNTRACK_IPV4=y
+CONFIG_NF_NAT_IPV4=y
+CONFIG_IP_NF_NAT=y
+
+# --- seccomp (BPF filter for container security) ---
+CONFIG_SECCOMP=y
+CONFIG_SECCOMP_FILTER=y
+
+# --- firmware loader (container firmware passthrough) ---
+CONFIG_FW_LOADER=y
+CONFIG_FW_LOADER_USER_HELPER=y
+
+# --- disable Android paranoid network so containers get internet ---
+# (aid_inet gid is handled by Droidspaces rootfs instead)
+# CONFIG_ANDROID_PARANOID_NETWORK is not set
